# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local — settings.local.json is per-developer
.claude/settings.local.json
# Exception: the template under templates/ ships with the repo so that
# /init-proyecto can copy it to a new project's .claude/settings.local.json
!templates/.claude/settings.local.json

# Logs and temp
*.log
.tmp/

# Training — material binario producido se regenera con scripts del repo.
# Audio: ~97 MB por serie, regenerable con narrar.py — no versionar.
training/**/audio/
training/**/*.wav
training/**/*.mp3
# Video: ~37 MB por serie, regenerable con componer.py — no versionar.
training/**/video/
training/**/*.mp4
# Slides PNG: ligeros (~3 MB por serie) y útiles como referencia visual
# del estado del repo en cada release — SÍ versionar.
# Solo excluir archivos auxiliares dentro de slides-render/:
training/**/slides-render/**/_input.md
training/**/*.pdf
