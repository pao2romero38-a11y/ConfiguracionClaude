# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local — settings.local.json is per-developer
.claude/settings.local.json
# Exception: the template under templates/ ships with the repo so that
# /init-proyecto can copy it to a new project's .claude/settings.local.json
!templates/.claude/settings.local.json

# Logs and temp
*.log
.tmp/

# Training — material producido se regenera con .claude/scripts/narrar.py
# y herramientas de render (pandoc, ffmpeg). No versionar binarios pesados.
training/**/audio/
training/**/*.wav
training/**/*.mp3
training/**/*.mp4
training/**/slides-render/
training/**/*.pdf
